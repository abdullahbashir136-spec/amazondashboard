# Keepa API key — get one at https://keepa.com/#!api
# Paid, token-based, official REST API. This is the ONLY Amazon data source in v1.
# Copy this file to `.env` and paste your real key. `.env` is gitignored — never commit it.
KEEPA_API_KEY=your_keepa_api_key_here

# Keepa domain id: 1=US, 2=UK, 3=DE, 4=FR, 5=JP, 6=CA, 8=IT, 9=ES, 10=IN
KEEPA_DOMAIN=1

# Optional: force demo mode even when a key is present (useful for UI work).
# Any value other than "1" / "true" is treated as off.
DEMO_MODE=0
